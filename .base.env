DB_HOST=<db-host>
DB_USER=<db-user>
DB_NAME=<db-name>
DB_PORT=5432
PORT=4000
GRPC_PORT=50051

DB_PASSWORD=<db-password>
TOKEN_KEY=<same-as-gnosis-main-service>

# K8S env vars
# to set env to k8s yaml
# $ set -o allexport
# $ source .env
# $ set +o allexport
# $ envsubst < deployment/k8s.yaml > deployment/k8s_patched.yaml

IMAGE_NAME=<image-name>
IMAGE_TAG=<image-tag>

K8S_MIN_REPLICAS=1
K8S_NAMESPACE=<deployment-namespace>
K8S_RESOURCES_LIMITS_CPU=500m
K8S_RESOURCES_LIMITS_MEMORY=256Mi
K8S_RESOURCES_REQUESTS_CPU=20m
K8S_RESOURCES_REQUESTS_MEMORY=30Mi
K8S_SERVICE_NAME=gnosis-workspace
